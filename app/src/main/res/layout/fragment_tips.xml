<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:context=".TipsFragment">

    <!-- Custom Toolbar untuk Tips Belanja dengan warna Cokelat Kayu (#603814) & tombol back -->
    <LinearLayout
        android:id="@+id/toolbarTips"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#603814"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBackTips"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_white"
            android:clickable="true"
            android:contentDescription="Kembali"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/txtTipsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Tips Belanja EcoMarket"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ListView untuk menampilkan daftar tips -->
    <ListView
        android:id="@+id/listViewTips"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp"
        android:padding="8dp" />

</LinearLayout>
